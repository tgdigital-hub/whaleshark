# What a restart of the keeper and the end of the lead agent's session do to the
# terminals' picture, and to how a worker's command is run afterwards.
fixture evening-2114

pane fleet: 60x20
expect-row "Lead · idle"
expect-row "sign-up page · working"
kill-orchestrator
expect-row "Lead · unknown"
restart-terminals
expect-row "sign-up page · idle"
as-worker T2.1: version          -> expect whaleshark
