# The runner's own test. It needs no command that changes a run: the answers
# it expects come from help, from version and from the caller rules, which
# refuse before a command is looked for.
fixture evening-2114
agent T1.1: progress 85 "nearly there" | write-result | report-with-token not-the-token | report done "ok"

orch: version                    -> expect whaleshark herdr
human: version
human: page: help guide          -> expect "the guide that matches"
as-unbound: pause                -> expect exit 5 "the person's to run"
as-worker T1.1: pause --human    -> expect exit 5 "not for an agent's tab"
as-worker T1.1: help report      -> expect "report done|failed"
orch: help wait &
kill-wait

pane fleet: 60x20
expect-row "login page · idle"
expect-row "search box · working"
term-event blocked T3
expect-row "search box · blocked"
term-drop idle T4
expect-row "search results · idle"
term-event focused lead
click "search box"
expect-last-line "clicked search box"
type "yes"
key enter
expect-last-line "typed yes"
clock +30s
expect-row "21:14:30"
notices off
pane actions: 40x6
expect-last-line "actions, notices off"
pane fleet:
expect-last-line "typed yes"

assert: T7 status review; T3 failures 0 name "search box"; attempts T7.1 reported, T1.1 working
assert: no event lost; no event twice
