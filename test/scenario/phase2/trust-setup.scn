# What a project's own file would run is run only once the person has
# approved it, and not again after it was changed until they approve anew.
# The lead agent hears of each start that went without it.
agent A.1: edit a.txt | commit | write-result | report done "a is in"
agent B.1: edit b.txt | commit | write-result | report done "b is in"
agent C.1: edit c.txt | commit | write-result | report done "c is in"

file brief.md: Target: three files | Change: yours | Constraints: none | Ownership: your own file | Acceptance: the check passes
file .gitignore: *.made
file whaleshark.toml: [setup] | script = "touch setup.made"
git
orch: init
orch: run new "three files"                         -> expect r1
task A "Write a" --name "file a" --check "test -f a.txt" --brief brief.md
task B "Write b" --name "file b" --check "test -f b.txt" --brief brief.md --after A
task C "Write c" --name "file c" --check "test -f c.txt" --brief brief.md --after B
orch: start A                                       -> expect "(A.1)"
await: attempts A.1 reported
orch: wait --timeout 10                             -> expect untrusted "[setup] script is not approved" done
orch: accept A
approve
orch: start B                                       -> expect "(B.1)"
await: attempts B.1 reported
orch: wait --ack last --timeout 10                  -> expect done
orch: accept B
file whaleshark.toml: [setup] | script = "touch other.made"
orch: start C                                       -> expect "(C.1)"
await: attempts C.1 reported
orch: wait --ack last --timeout 10                  -> expect done
orch: accept C
human: trust --json                                 -> expect "touch other.made" changed

assert: A worktree.setup untrusted; B worktree.setup ok; C worktree.setup untrusted; A status done; B status done; C status done; no event lost
