<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.tgdigital-hub.whaleshark.engine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/reef tools/whale&#34;shark&#34; &amp; $co &lt;100%&gt;</string>
		<string>engine</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/reef tools/bin:/usr/bin</string>
		<key>SHELL</key>
		<string>/bin/zsh</string>
		<key>LANG</key>
		<string>en_GB.UTF-8</string>
		<key>XDG_STATE_HOME</key>
		<string>/srv/reef/state &#34;a&#34; &amp; &lt;b&gt; 100% $HOME \n</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
